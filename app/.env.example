# ── Provider ───────────────────────────────────────────────────────
# openai (default) also covers any OpenAI-compatible endpoint: GLM, DeepSeek,
# vLLM, Ollama, OpenRouter, LiteLLM. anthropic talks to the Messages API.
LLM_PROVIDER=openai

# Credential. Provider-native names still work as fallbacks:
#   openai    → OPENAI_API_KEY
#   anthropic → ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
LLM_API_KEY=

# Endpoint. Include the version path your gateway expects, e.g.
#   https://open.bigmodel.cn/api/paas/v4
#   https://api.deepseek.com/v1
# OPENAI_BASE_URL / ANTHROPIC_BASE_URL also work.
LLM_BASE_URL=

# ── Model routing ─────────────────────────────────────────────────
# fast: tutor chat, hints, goal refinement, quizzes
# smart: skill-gap analysis, path scheduling, content, evaluation
LLM_FAST_MODEL=glm-5.3-flash
LLM_SMART_MODEL=glm-5.3-flash

# GLM-style gateways accept thinking:{type:"disabled"}; official OpenAI rejects it.
# LLM_OPENAI_THINKING=disabled
# Newer OpenAI models want max_completion_tokens instead of max_tokens.
# LLM_OPENAI_TOKEN_PARAM=max_completion_tokens

# ── Testing ───────────────────────────────────────────────────────
# live (default) | record | replay — see src/lib/llm/replay.ts
# GENMENTOR_LLM_MODE=live
